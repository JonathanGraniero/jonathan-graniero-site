NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://site:site@localhost:5432/site?schema=public
# Origin allowed by CORS (the Vite dev server in development).
WEB_ORIGIN=http://localhost:5173
# Public base URL used in RSS/sitemap links.
SITE_URL=http://localhost:5173
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_TTL_SECONDS=86400
# Admin account created/updated by `npm run db:seed`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
