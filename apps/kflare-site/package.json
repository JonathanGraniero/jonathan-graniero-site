{
  "name": "@site/kflare-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "kflare.dev: the kflare project site, pre-rendered React served as static Worker assets.",
  "scripts": {
    "predev": "node scripts/fetch-kflare.mjs --if-missing",
    "dev": "vite",
    "prebuild": "node scripts/fetch-kflare.mjs --if-missing",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-server && node scripts/prerender.mjs",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "fetch-kflare": "node scripts/fetch-kflare.mjs",
    "pretypecheck": "node scripts/fetch-kflare.mjs --if-missing",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/fetch-kflare.mjs --if-missing",
    "test": "vitest run"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "github-slugger": "^2.0.0",
    "jsdom": "^30.1.1",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "unified": "^11.0.5",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.143.0",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
