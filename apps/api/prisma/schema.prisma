// Data model for the personal site.
// Connection settings live in prisma.config.ts (Prisma 7+).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum SkillCategory {
  LANGUAGE
  FRONTEND
  BACKEND
  DATA
  INFRA
  TOOLING
}

model Post {
  id             String     @id @default(cuid())
  slug           String     @unique
  title          String
  excerpt        String
  contentMd      String
  coverImage     String?
  status         PostStatus @default(DRAFT)
  publishedAt    DateTime?
  readingTimeMin Int        @default(1)
  tags           Tag[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status, publishedAt(sort: Desc)])
}

model Tag {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  posts Post[]
}

/// Singleton row (id = 1) describing the site owner.
model Profile {
  id        Int      @id @default(1)
  name      String
  headline  String
  bio       String
  location  String
  avatarUrl String?
  resumeUrl String?
  github    String?
  linkedin  String?
  email     String?
  website   String?
  updatedAt DateTime @updatedAt
}

model Experience {
  id         String    @id @default(cuid())
  company    String
  role       String
  location   String?
  startDate  DateTime
  endDate    DateTime?
  summary    String
  highlights String[]
  tech       String[]
  sortOrder  Int       @default(0)
}

model Skill {
  id       String        @id @default(cuid())
  name     String        @unique
  category SkillCategory
  level    Int
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String
  url         String?
  repoUrl     String?
  tech        String[]
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
