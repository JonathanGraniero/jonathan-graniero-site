# Test-only configuration (committed on purpose — nothing here is secret).
# Points at the `db-test` service from docker-compose.yml (tmpfs, port 5433).
NODE_ENV=test
PORT=3001
DATABASE_URL=postgresql://site:site@localhost:5433/site_test?schema=public
WEB_ORIGIN=http://localhost:5173
SITE_URL=http://localhost:5173
JWT_SECRET=test-secret-test-secret-test-secret-0123456789
JWT_TTL_SECONDS=3600
ADMIN_EMAIL=admin@test.local
ADMIN_PASSWORD=test-password-123
